<div class="w-full max-w-md mx-auto">
<h2 class="text-2xl font-bold mb-4">Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <p><%= f.label :email, class: "mb-2 text-sm font-medium text-gray-700" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password, class: "mb-2 text-sm font-medium text-gray-700" %></p>
    <p><%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %></p>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <p><%= f.check_box :remember_me, class: "mr-2" %></p>
      <p><%= f.label :remember_me, class: "text-sm font-medium text-gray-700" %></p>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Log in", class: "bg-gray-100 px-4 py-2 rounded cursor-pointer hover:bg-gray-200" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
</div>
