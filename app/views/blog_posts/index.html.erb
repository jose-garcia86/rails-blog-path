<h1 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 lg:text-5xl">Blog Posts</h1>
<% @blog_posts.each do |blog_post| %>
  <div class="w-full max-w-md mx-auto py-4">
      <% if blog_post.draft? %>
        <p class="text-gray-500 p-2 rounded bg-gray-50">Draft</p>
        <% elsif blog_post.scheduled? %>
        <p class="text-gray-500 p-2 rounded bg-blue-50">Scheduled</p>
      <% end %>
    <h2 class="mb-2 text-2xl tracking-tight font-extrabold text-gray-900"><%= link_to blog_post.title, blog_post %></h2>
    <p><%= blog_post.body %></p>
  </div>
<% end %>
